% quiet_light.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{quiet_light}[2026/06/02 v0.2 Quiet Light beamer theme]

% --- 1. Package options ------------------------------------------------------
\RequirePackage{iftex}
\RequirePackage{kvoptions}

\SetupKeyvalOptions{family=quietlight,prefix=ql@}
\DeclareBoolOption[true]{fonts}
\DeclareComplementaryOption{nofonts}{fonts}
\DeclareStringOption[Songti TC]{cjkmainfont}
\DeclareStringOption[Songti TC]{cjksansfont}
\DeclareStringOption[Songti TC]{cjkmonofont}
\DeclareStringOption[Menlo]{monofont}
\DeclareStringOption[2.5]{fakebold}
\ProcessKeyvalOptions*

% --- 2. Base theme and fonts -------------------------------------------------
\usetheme{metropolis}
\metroset{numbering=fraction}

\ifql@fonts
  \ifXeTeX
  \else
    \ifLuaTeX
    \else
      \PackageError{quiet_light}
        {quiet_light with fonts=true requires XeLaTeX or LuaLaTeX}
        {Use XeLaTeX/LuaLaTeX, or load the package with [fonts=false].}
    \fi
  \fi

  \RequirePackage[fontset=none]{ctex}
  \RequirePackage{fontspec}

  \setCJKmainfont[AutoFakeBold=\ql@fakebold]{\ql@cjkmainfont}
  \setCJKsansfont[AutoFakeBold=\ql@fakebold]{\ql@cjksansfont}
  \setCJKmonofont{\ql@cjkmonofont}
  \setmonofont{\ql@monofont}[Scale=0.9]
\fi

% --- 3. Dependencies ---------------------------------------------------------
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,listings}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{environ}
\RequirePackage{etoolbox}
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{tikz}
\RequirePackage{xcolor}

% --- 4. Color system ---------------------------------------------------------
\definecolor{QLBg}{RGB}{245,243,247}
\definecolor{QLFg}{RGB}{67,67,67}
\definecolor{QLPurple}{RGB}{112,86,151}
\definecolor{QLBlue}{RGB}{23,123,189}
\definecolor{QLRed}{RGB}{190,60,60}
\definecolor{QLGreen}{RGB}{68,140,39}
\definecolor{QLMuted}{RGB}{119,119,119}
\definecolor{QLLine}{RGB}{214,207,224}

\setbeamercolor{background canvas}{bg=QLBg}
\setbeamercolor{normal text}{fg=QLFg,bg=QLBg}
\setbeamercolor{frametitle}{bg=QLBg,fg=QLPurple}
\setbeamercolor{title}{fg=QLPurple}
\setbeamercolor{subtitle}{fg=QLFg}
\setbeamercolor{author}{fg=QLFg}
\setbeamercolor{date}{fg=QLMuted}
\setbeamercolor{palette primary}{bg=QLPurple,fg=white}
\setbeamercolor{structure}{fg=QLBlue}
\setbeamercolor{alerted text}{fg=QLRed}
\setbeamercolor{progress bar}{fg=QLPurple,bg=QLLine}
\setbeamercolor{caption name}{fg=QLPurple}

\setbeamerfont{title}{series=\bfseries}
\setbeamerfont{frametitle}{series=\bfseries}
\setbeamerfont{caption}{size=\scriptsize}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{itemize item}{\color{QLPurple}\small\textbullet}
\setbeamertemplate{itemize subitem}{\color{QLBlue}\scriptsize\textbullet}
\setbeamertemplate{enumerate item}{\color{QLPurple}\insertenumlabel.}

% --- 5. Frame title ----------------------------------------------------------
\makeatletter
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[%
      wd=\paperwidth,%
      sep=0pt,%
      leftskip=\metropolis@frametitle@padding,%
      rightskip=\metropolis@frametitle@padding%
    ]{frametitle}%
    \metropolis@frametitlestrut@start%
    \insertframetitle%
    \nolinebreak%
    \metropolis@frametitlestrut@end%
  \end{beamercolorbox}%
  \vspace{-1.4ex}%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[dashed,color=QLPurple!60,line width=0.6pt]
      (current page.west |- 0,0) -- (current page.east |- 0,0);
  \end{tikzpicture}%
}
\makeatother

% --- 6. Cards and blocks -----------------------------------------------------
\tcbset{
  qlcard/.style={
    enhanced,
    arc=3mm,
    boxrule=0pt,
    left=6pt,
    right=6pt,
    top=6pt,
    bottom=6pt,
    colback=QLBg!30!white,
    drop fuzzy shadow=black!30!QLBg,
    separator sign=none
  },
  qlcardtitle/.style={
    fonttitle=\bfseries,
    colframe=QLPurple!15,
    colbacktitle=QLPurple!15,
    coltitle=QLPurple
  },
  tablecardstyle/.style={
    qlcard,
    left=0pt,
    right=0pt,
    top=0pt,
    bottom=0pt,
    boxsep=0pt,
    clip upper,
    colback=white
  }
}

\newtcolorbox{quietcard}[1][]{qlcard,#1}

\NewEnviron{cardtable}[2][]{%
  \begin{tcolorbox}[tablecardstyle,#1]%
    \renewcommand{\arraystretch}{1.4}%
    \begin{tabularx}{\linewidth}{#2}%
      \BODY%
    \end{tabularx}%
  \end{tcolorbox}%
}

\setbeamertemplate{block begin}{%
  \begin{tcolorbox}[qlcard,qlcardtitle,title={\insertblocktitle}]%
}
\setbeamertemplate{block end}{\end{tcolorbox}}

\setbeamertemplate{block alerted begin}{%
  \begin{tcolorbox}[qlcard,title={\insertblocktitle},fonttitle=\bfseries,
    colframe=QLRed!15,colbacktitle=QLRed!15,coltitle=QLRed]%
}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}

\setbeamertemplate{block example begin}{%
  \begin{tcolorbox}[qlcard,title={\insertblocktitle},fonttitle=\bfseries,
    colframe=QLBlue!15,colbacktitle=QLBlue!15,coltitle=QLBlue]%
}
\setbeamertemplate{block example end}{\end{tcolorbox}}

% --- 7. Code blocks ----------------------------------------------------------
\newtcblisting{codeblock}[2][]{%
  qlcard,
  listing only,
  listing engine=listings,
  title={#2},
  listing options={
    language={#1},
    basicstyle=\ttfamily\small\color{QLFg},
    keywordstyle=\color{QLPurple}\bfseries,
    stringstyle=\color{QLGreen},
    commentstyle=\color{QLMuted},
    breaklines=true,
    columns=flexible,
    basewidth=0.5em,
    showstringspaces=false,
    numbers=none
  },
  code={%
    \ifstrempty{#2}
      {\tcbset{colframe=QLBg!30!white,top=-2pt}}
      {\tcbset{qlcardtitle,fonttitle=\bfseries\small}}%
  }%
}

% --- 8. Images ---------------------------------------------------------------
\newcommand{\shadowimage}[2][width=\linewidth,height=0.7\textheight,keepaspectratio]{%
  \begin{center}
    \begin{tcolorbox}[qlcard,colback=white,boxsep=0pt,
      left=4pt,right=4pt,top=4pt,bottom=4pt,
      hbox,halign=center,valign=center]
      \includegraphics[#1]{#2}
    \end{tcolorbox}
  \end{center}
}

\newcommand{\shadowimageplain}[2][width=\linewidth,height=0.7\textheight,keepaspectratio]{%
  \begin{center}
    \begin{tcolorbox}[qlcard,colback=white,boxsep=0pt,
      left=0pt,right=0pt,top=0pt,bottom=0pt,
      clip upper,hbox,halign=center,valign=center]
      \includegraphics[#1]{#2}
    \end{tcolorbox}
  \end{center}
}

\let\qlimage\shadowimageplain
\let\qlimageframed\shadowimage

\endinput
